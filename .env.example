HOST=127.0.0.1
PORT=REPLACE_WITH_INTERNAL_PORT
ASTERIA_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
AI_CORE_BASE_URL=http://127.0.0.1:18080
AI_CORE_API_KEY=REPLACE_WITH_AI_CORE_ROUTER_API_KEY
ASTERIA_TRANSLATION_TIMEOUT_MS=90000
ASTERIA_MAX_BODY_BYTES=1000000
ASTERIA_MEMORY_FILE=/app/data/translation-memory.jsonl

# Optional Japanese Language Intelligence Adapter. Configure both values or neither.
# DJPMCP must remain loopback-only. Actual key values are runtime secrets and must not be committed.
# DJPMCP_BASE_URL=http://127.0.0.1:8765
# DJPMCP_API_KEY=REPLACE_WITH_DJPMCP_HTTP_API_KEY
DJPMCP_TIMEOUT_MS=1000

# TGserver ZERO P007 runtime logging. Keep this endpoint private.
# No per-producer TGserver log secret is used.
TGSERVER_LOG_URL=http://127.0.0.1:3000
TGSERVER_LOG_TIMEOUT_MS=1500
