{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterav8.jp/schemas/asteria-japanese-ab-v1.schema.json",
  "title": "asteria Japanese A/B Benchmark Case v1",
  "description": "Non-authoritative source-side contract for Japanese DJPMCP OFF/ON semantic-integrity A/B cases. Generated reference translations are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_schema",
    "corpus_version",
    "id",
    "source_language",
    "target_language",
    "source",
    "semantic_risks",
    "protected_invariants",
    "ambiguity_contract",
    "review_status"
  ],
  "properties": {
    "benchmark_schema": {
      "const": "asteria-japanese-ab-v1"
    },
    "corpus_version": {
      "const": "japanese-ab-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "source_language": {
      "const": "ja"
    },
    "target_language": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "semantic_risks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "negation",
          "nested_conditions",
          "exceptions",
          "permission_prohibition",
          "modality",
          "references_ellipsis",
          "quantities_deadlines",
          "ordering_causality",
          "prompt_injection_as_data",
          "explicit_ambiguity"
        ]
      }
    },
    "protected_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "value",
              "adjudication"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
              },
              "kind": {
                "const": "literal"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "adjudication": {
                "const": "AUTOMATIC"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "requirement",
              "adjudication"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
              },
              "kind": {
                "const": "semantic"
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "adjudication": {
                "const": "HUMAN_REQUIRED"
              }
            }
          }
        ]
      }
    },
    "ambiguity_contract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectation"
          ],
          "properties": {
            "expectation": {
              "const": "NONE"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectation",
            "subject"
          ],
          "properties": {
            "expectation": {
              "const": "MUST_REMAIN_UNRESOLVED"
            },
            "subject": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "review_status": {
      "const": "SEED_NOT_ACCEPTANCE_AUTHORITY"
    }
  }
}
